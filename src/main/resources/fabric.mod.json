{
    "schemaVersion": 1,
    "id": "engineers-bliss",
    "version": "${version}",
    "name": "Engineer's Bliss",
    "description": "A rendering and utility mod for Redstone engineers",
    "authors": [
        "UwU_Snek"
    ],
    "contributors": [
        "Snek's cat Cesare",
        "Snek's 83 cans of Monster"
    ],
    "contact": {
        "homepage": "https://fabricmc.net/",
        "sources": "https://github.com/FabricMC/fabric-example-mod"
    },
    "license": "GPL-3.0",
    "icon": "assets/engineers-bliss/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.snek.engineersbliss.EngineerSBliss"
        ],
        "client": [
            "com.snek.engineersbliss.client.EngineerSBlissClient"
        ]
    },
    "mixins": [
        "engineers-bliss.mixins.json",
        {
            "config": "engineers-bliss.client.mixins.json",
            "environment": "client"
        },
        {
            "config": "sodium.client.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": ">=0.19.3",
        "minecraft": "~26.1",
        "java": ">=25",
        "fabric-api": "*"
    },
    "suggests": {
        "sodium": ">=0.8.9"
    }
}